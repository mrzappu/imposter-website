<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Order History</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================== NAVBAR (EMBEDDED DIRECTLY) ==================== -->
    <nav>
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a>
                <a href="/shop" class="<%= currentPage === 'shop' ? 'active' : '' %>">Shop</a>
                <a href="/cart" class="cart-link <%= currentPage === 'cart' ? 'active' : '' %>">
                    Cart
                    <span class="cart-badge" id="cartCount">0</span>
                </a>
                <a href="/history" class="<%= currentPage === 'history' ? 'active' : '' %>">History</a>
                <a href="/terms" class="<%= currentPage === 'terms' ? 'active' : '' %>">Terms</a>
                
                <% if (user) { %>
                    <a href="/admin" style="<%= isAdmin ? '' : 'display:none;' %>" class="<%= currentPage === 'admin' ? 'active' : '' %>">Admin</a>
                    
                    <div class="profile-container">
                        <div class="profile-trigger">
                            <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="profile-avatar">
                            <span class="profile-name"><%= user.username %></span>
                        </div>
                        <div class="profile-dropdown">
                            <div class="profile-header">
                                <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="profile-header-avatar">
                                <div class="profile-header-info">
                                    <h4><%= user.username %></h4>
                                    <p>ID: <%= user.id.substring(0, 8) %>...</p>
                                </div>
                            </div>
                            <a href="/profile" class="profile-menu-item">👤 My Profile</a>
                            <a href="/history" class="profile-menu-item">📜 My Orders</a>
                            <a href="/settings" class="profile-menu-item">⚙️ Settings</a>
                            <a href="/logout" class="profile-menu-item logout">🚪 Logout</a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="discord-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515c-.209.377-.456.885-.624 1.3a18.277 18.277 0 0 0-5.487 0 12.64 12.64 0 0 0-.633-1.3 19.736 19.736 0 0 0-4.885 1.515c-2.86 4.27-3.636 8.432-3.208 12.502a20.11 20.11 0 0 0 6.066 2.98c.49-.664.926-1.383 1.302-2.14a13.193 13.193 0 0 1-2.052-.991c.173-.126.342-.258.506-.39a14.545 14.545 0 0 0 12.436 0c.165.132.334.264.507.39-.65.38-1.336.714-2.053.991.376.757.812 1.476 1.302 2.14a20.05 20.05 0 0 0 6.065-2.98c.506-4.587-.79-8.7-3.208-12.502zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419z"/>
                        </svg>
                        Login
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <style>
        .profile-container { position: relative; display: inline-block; }
        .profile-trigger { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; padding: 0.3rem; border-radius: 40px; }
        .profile-trigger:hover { background: rgba(255,0,0,0.1); }
        .profile-avatar { width: 40px; height: 40px; border-radius: 50%; border: 2px solid #ff0000; }
        .profile-name { font-weight: 600; color: white; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .profile-dropdown { position: absolute; top: 50px; right: 0; background: #1a1a1a; border: 1px solid #333; border-radius: 10px; width: 250px; padding: 1rem; display: none; z-index: 1000; }
        .profile-container:hover .profile-dropdown { display: block; }
        .profile-header { display: flex; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #333; }
        .profile-header-avatar { width: 50px; height: 50px; border-radius: 50%; border: 2px solid #ff0000; }
        .profile-header-info h4 { color: white; }
        .profile-header-info p { color: #999; font-size: 0.8rem; }
        .profile-menu-item { display: flex; align-items: center; gap: 0.8rem; padding: 0.8rem; color: white; text-decoration: none; }
        .profile-menu-item:hover { background: rgba(255,0,0,0.1); color: #ff0000; }
        .profile-menu-item.logout { border-top: 1px solid #333; margin-top: 0.5rem; color: #ff0000; }
        .discord-btn { background: #5865F2; color: white !important; padding: 0.6rem 1.5rem !important; border-radius: 30px !important; display: flex !important; align-items: center; gap: 0.5rem; }
        .cart-link { position: relative; }
        .cart-badge { position: absolute; top: -8px; right: -12px; background: #ff0000; color: white; font-size: 0.7rem; min-width: 18px; height: 18px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0 4px; }
        .nav-links a.active { color: #ff0000; }
        .success-message {
            background: rgba(0, 255, 0, 0.1);
            border: 1px solid #00ff00;
            color: #00ff00;
            padding: 1rem;
            border-radius: 5px;
            margin-bottom: 1rem;
            text-align: center;
        }
        .empty-history {
            text-align: center;
            padding: 4rem;
        }
        .empty-history-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.3;
        }
        .empty-history h2 {
            color: var(--primary);
            margin-bottom: 1rem;
        }
        .empty-history p {
            color: #999;
            margin-bottom: 2rem;
        }
        .history-table-container {
            background: #111;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 1.5rem;
            overflow-x: auto;
        }
        .history-table {
            width: 100%;
            border-collapse: collapse;
        }
        .history-table th {
            text-align: left;
            padding: 1rem;
            background: #1a1a1a;
            color: #ff0000;
            font-weight: 600;
            border-bottom: 2px solid #333;
        }
        .history-table td {
            padding: 1rem;
            border-bottom: 1px solid #333;
            color: #999;
        }
        .order-items-list {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        .order-item-row {
            display: flex;
            gap: 0.5rem;
            font-size: 0.9rem;
        }
        .item-quantity {
            color: #ff0000;
            font-weight: 600;
            min-width: 30px;
        }
        .item-name {
            color: white;
        }
        .item-price {
            color: #ff0000;
            margin-left: auto;
        }
        .status-badge {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .status-pending {
            background: rgba(255, 170, 0, 0.2);
            color: #ffaa00;
            border: 1px solid #ffaa00;
        }
        .status-approved {
            background: rgba(0, 255, 0, 0.2);
            color: #00ff00;
            border: 1px solid #00ff00;
        }
        .status-rejected {
            background: rgba(255, 0, 0, 0.2);
            color: #ff0000;
            border: 1px solid #ff0000;
        }
        .btn-view-proof {
            padding: 0.2rem 0.5rem;
            background: #ff0000;
            color: white;
            text-decoration: none;
            border-radius: 3px;
            font-size: 0.8rem;
        }
        .no-proof {
            color: #666;
            font-size: 0.8rem;
            font-style: italic;
        }
    </style>

    <script>
        async function updateCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                const data = await res.json();
                document.getElementById('cartCount').textContent = data.count;
            } catch (e) {}
        }
        <% if (user) { %>
            updateCartCount();
            setInterval(updateCartCount, 30000);
        <% } %>
        
        document.querySelectorAll('.profile-container').forEach(c => {
            c.addEventListener('mouseenter', function() { this.querySelector('.profile-dropdown').style.display = 'block'; });
            c.addEventListener('mouseleave', function() { this.querySelector('.profile-dropdown').style.display = 'none'; });
        });
    </script>

    <div class="shop-header">
        <div class="container">
            <h1 class="page-title">Order History</h1>
            <p class="page-subtitle">Track all your purchases and their status</p>
        </div>
    </div>

    <div class="container">
        <% if (success === 'order_placed') { %>
            <div class="success-message">
                ✅ Order placed successfully! Your payment proof has been submitted for review.
            </div>
        <% } %>

        <% if (!orders || orders.length === 0) { %>
            <div class="empty-history">
                <div class="empty-history-icon">📜</div>
                <h2>No orders yet</h2>
                <p>You haven't placed any orders. Start shopping now!</p>
                <a href="/shop" class="btn-primary">Browse Shop</a>
            </div>
        <% } else { %>
            <div class="history-table-container">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Items</th>
                            <th>Subtotal</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Proof</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td>#<%= order.id %></td>
                                <td>
                                    <div class="order-items-list">
                                        <% if (order.itemsParsed && order.itemsParsed.length > 0) { %>
                                            <% order.itemsParsed.forEach(item => { %>
                                                <div class="order-item-row">
                                                    <span class="item-quantity"><%= item.quantity %>x</span>
                                                    <span class="item-name"><%= item.name %></span>
                                                    <span class="item-price">₹<%= (item.price * item.quantity).toFixed(2) %></span>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span><%= order.items %></span>
                                        <% } %>
                                    </div>
                                </td>
                                <td>₹<%= order.subtotal.toFixed(2) %></td>
                                <td>-₹<%= order.discount.toFixed(2) %></td>
                                <td><strong>₹<%= order.total.toFixed(2) %></strong></td>
                                <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                <td>
                                    <span class="status-badge status-<%= order.status %>">
                                        <%= order.status.toUpperCase() %>
                                    </span>
                                </td>
                                <td>
                                    <% if (order.proof) { %>
                                        <a href="/uploads/<%= order.proof %>" target="_blank" class="btn-view-proof">View</a>
                                    <% } else { %>
                                        <span class="no-proof">No proof</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
                <p>Premium digital marketplace</p>
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/terms">Terms</a>
                <a href="/history">History</a>
            </div>
            <div class="footer-copyright">
                <p>IMPOSTER Network © 2026-2027</p>
            </div>
        </div>
    </footer>
</body>
</html>

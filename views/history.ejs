<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Order History</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="glass-nav">
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/cart" class="cart-link">
                    Cart
                    <span class="cart-badge" id="cartCount">0</span>
                </a>
                <a href="/history" class="active">History</a>
                <a href="/terms">Terms</a>
                <% if (user) { %>
                    <a href="/admin" style="<%= isAdmin ? '' : 'display:none;' %>" class="admin-link">Admin</a>
                    <div class="user-menu">
                        <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="user-avatar">
                        <span class="username"><%= user.username %></span>
                        <a href="/logout" class="logout-btn">Logout</a>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="discord-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515c-.209.377-.456.885-.624 1.3a18.277 18.277 0 0 0-5.487 0 12.64 12.64 0 0 0-.633-1.3 19.736 19.736 0 0 0-4.885 1.515c-2.86 4.27-3.636 8.432-3.208 12.502a20.11 20.11 0 0 0 6.066 2.98c.49-.664.926-1.383 1.302-2.14a13.193 13.193 0 0 1-2.052-.991c.173-.126.342-.258.506-.39a14.545 14.545 0 0 0 12.436 0c.165.132.334.264.507.39-.65.38-1.336.714-2.053.991.376.757.812 1.476 1.302 2.14a20.05 20.05 0 0 0 6.065-2.98c.506-4.587-.79-8.7-3.208-12.502zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419z"/>
                        </svg>
                        Login with Discord
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <main>
        <div class="shop-header">
            <div class="container">
                <h1 class="page-title">Order History</h1>
                <p class="page-subtitle">Track all your purchases and their status</p>
            </div>
        </div>

        <div class="container">
            <% if (!orders || orders.length === 0) { %>
                <div class="empty-history glass-card">
                    <div class="empty-history-icon">📜</div>
                    <h2>No orders yet</h2>
                    <p>You haven't placed any orders. Start shopping now!</p>
                    <a href="/shop" class="btn-primary">Browse Shop</a>
                </div>
            <% } else { %>
                <div class="history-table-container glass-card">
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Proof</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.id %></td>
                                    <td>
                                        <div class="order-items-list">
                                            <% if (order.itemsParsed && order.itemsParsed.length > 0) { %>
                                                <% order.itemsParsed.forEach(item => { %>
                                                    <div class="order-item-row">
                                                        <span class="item-quantity"><%= item.quantity %>x</span>
                                                        <span class="item-name"><%= item.name %></span>
                                                        <span class="item-price">$<%= (item.price * item.quantity).toFixed(2) %></span>
                                                    </div>
                                                <% }) %>
                                            <% } else { %>
                                                <span><%= order.items %></span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="order-total">$<%= order.total.toFixed(2) %></td>
                                    <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge status-<%= order.status %>">
                                            <%= order.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (order.proof) { %>
                                            <a href="/uploads/<%= order.proof %>" target="_blank" class="btn-view-proof">View</a>
                                        <% } else { %>
                                            <span class="no-proof">No proof</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="glass-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <span class="logo-imposter">IMPOSTER</span>
                    <span class="logo-network">NETWORK</span>
                    <p>Premium digital marketplace</p>
                </div>
                <div class="footer-links">
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/terms">Terms</a>
                    <a href="/history">History</a>
                </div>
                <div class="footer-copyright">
                    <p>Dev Rick • IMPOSTER Network © 2026-2027</p>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .empty-history {
            text-align: center;
            padding: 4rem 2rem;
            max-width: 500px;
            margin: 2rem auto;
        }
        
        .empty-history-icon {
            font-size: 5rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
        
        .empty-history h2 {
            color: var(--primary);
            margin-bottom: 1rem;
        }
        
        .empty-history p {
            color: var(--text-secondary);
            margin-bottom: 2rem;
        }
        
        .history-table-container {
            padding: 1.5rem;
            margin-top: 2rem;
            overflow-x: auto;
        }
        
        .history-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .history-table th {
            text-align: left;
            padding: 1rem;
            background: rgba(255,0,0,0.1);
            color: var(--primary);
            font-weight: 600;
        }
        
        .history-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border-color);
        }
        
        .order-items-list {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        
        .order-item-row {
            display: flex;
            gap: 0.5rem;
            font-size: 0.9rem;
        }
        
        .item-quantity {
            color: var(--primary);
            font-weight: 600;
            min-width: 40px;
        }
        
        .item-name {
            color: var(--text-primary);
            flex: 1;
        }
        
        .item-price {
            color: var(--primary);
            font-weight: 600;
            min-width: 70px;
            text-align: right;
        }
        
        .order-total {
            font-weight: 700;
            color: var(--primary);
        }
        
        .status-badge {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .status-pending {
            background: rgba(255, 170, 0, 0.2);
            color: var(--warning);
            border: 1px solid var(--warning);
        }
        
        .status-approved {
            background: rgba(0, 255, 0, 0.2);
            color: var(--success);
            border: 1px solid var(--success);
        }
        
        .status-rejected {
            background: rgba(255, 0, 0, 0.2);
            color: var(--danger);
            border: 1px solid var(--danger);
        }
        
        .btn-view-proof {
            padding: 0.3rem 0.8rem;
            background: var(--primary);
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-size: 0.8rem;
        }
        
        .no-proof {
            color: var(--text-secondary);
            font-size: 0.8rem;
            font-style: italic;
        }
        
        @media (max-width: 768px) {
            .history-table th,
            .history-table td {
                padding: 0.8rem;
                font-size: 0.8rem;
            }
            
            .order-item-row {
                flex-direction: column;
                gap: 0.1rem;
            }
            
            .item-price {
                text-align: left;
            }
        }
    </style>

    <script>
        async function updateCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                const data = await res.json();
                document.getElementById('cartCount').textContent = data.count;
            } catch (e) {
                console.error('Failed to update cart count');
            }
        }
        
        <% if (user) { %>
            updateCartCount();
            setInterval(updateCartCount, 30000);
        <% } %>
    </script>
</body>
</html>

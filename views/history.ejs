<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Order History</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <% include partials/navbar %>

    <div class="shop-header">
        <div class="container">
            <h1 class="page-title">Order History</h1>
            <p class="page-subtitle">Track all your purchases and their status</p>
        </div>
    </div>

    <div class="container">
        <% if (!orders || orders.length === 0) { %>
            <div class="empty-history">
                <div class="empty-history-icon">📜</div>
                <h2>No orders yet</h2>
                <p>You haven't placed any orders. Start shopping now!</p>
                <a href="/shop" class="btn-primary">Browse Shop</a>
            </div>
        <% } else { %>
            <div class="history-table-container">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Proof</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td>#<%= order.id %></td>
                                <td>
                                    <div class="order-items-list">
                                        <% if (order.itemsParsed && order.itemsParsed.length > 0) { %>
                                            <% order.itemsParsed.forEach(item => { %>
                                                <div class="order-item-row">
                                                    <span class="item-quantity"><%= item.quantity %>x</span>
                                                    <span class="item-name"><%= item.name %></span>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <span><%= order.items %></span>
                                        <% } %>
                                    </div>
                                </td>
                                <td>₹<%= order.total.toFixed(2) %></td>
                                <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                <td>
                                    <span class="status-badge status-<%= order.status %>">
                                        <%= order.status.toUpperCase() %>
                                    </span>
                                </td>
                                <td>
                                    <% if (order.proof) { %>
                                        <a href="/uploads/<%= order.proof %>" target="_blank" style="color: var(--primary);">View</a>
                                    <% } else { %>
                                        <span style="color: #666;">No proof</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
                <p>Premium digital marketplace</p>
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/terms">Terms</a>
                <a href="/history">History</a>
            </div>
            <div class="footer-copyright">
                <p>IMPOSTER Network © 2026-2027</p>
            </div>
        </div>
    </footer>

    <style>
        .empty-history {
            text-align: center;
            padding: 4rem;
        }
        
        .empty-history-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.3;
        }
        
        .empty-history h2 {
            color: var(--primary);
            margin-bottom: 1rem;
        }
        
        .empty-history p {
            color: #999;
            margin-bottom: 2rem;
        }
        
        .order-items-list {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        
        .order-item-row {
            display: flex;
            gap: 0.5rem;
            font-size: 0.9rem;
        }
        
        .item-quantity {
            color: var(--primary);
            font-weight: 600;
            min-width: 30px;
        }
        
        .item-name {
            color: white;
        }
        
        .status-badge {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        .status-pending {
            background: rgba(255, 170, 0, 0.1);
            color: var(--warning);
            border: 1px solid var(--warning);
        }
        
        .status-approved {
            background: rgba(0, 255, 0, 0.1);
            color: var(--success);
            border: 1px solid var(--success);
        }
        
        .status-rejected {
            background: rgba(255, 0, 0, 0.1);
            color: var(--danger);
            border: 1px solid var(--danger);
        }
    </style>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Premium Digital Marketplace</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="glass-nav">
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/" class="active">Home</a>
                <a href="/shop">Shop</a>
                <a href="/cart" class="cart-link">
                    Cart
                    <span class="cart-badge" id="cartCount">0</span>
                </a>
                <a href="/history">History</a>
                <a href="/terms">Terms</a>
                <% if (user) { %>
                    <a href="/admin" style="<%= isAdmin ? '' : 'display:none;' %>" class="admin-link">Admin</a>
                    <div class="user-menu">
                        <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="user-avatar">
                        <span class="username"><%= user.username %></span>
                        <a href="/logout" class="logout-btn">Logout</a>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="discord-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515c-.209.377-.456.885-.624 1.3a18.277 18.277 0 0 0-5.487 0 12.64 12.64 0 0 0-.633-1.3 19.736 19.736 0 0 0-4.885 1.515c-2.86 4.27-3.636 8.432-3.208 12.502a20.11 20.11 0 0 0 6.066 2.98c.49-.664.926-1.383 1.302-2.14a13.193 13.193 0 0 1-2.052-.991c.173-.126.342-.258.506-.39a14.545 14.545 0 0 0 12.436 0c.165.132.334.264.507.39-.65.38-1.336.714-2.053.991.376.757.812 1.476 1.302 2.14a20.05 20.05 0 0 0 6.065-2.98c.506-4.587-.79-8.7-3.208-12.502zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419z"/>
                        </svg>
                        Login with Discord
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <main>
        <!-- Login Success Message -->
        <% if (loginSuccess) { %>
            <div class="login-success-message">
                ✅ Successfully logged in! Welcome to IMPOSTER Network.
            </div>
        <% } %>
        
        <!-- Login Error Message -->
        <% if (loginError) { %>
            <div class="login-error-message">
                ❌ Login failed. Please try again.
            </div>
        <% } %>

        <!-- Hero Section -->
        <section class="hero-section">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1 class="hero-title">
                    <span class="gradient-text">IMPOSTER</span> Network
                </h1>
                <p class="hero-subtitle">The ultimate digital marketplace with instant delivery and Discord integration</p>
                <div class="hero-stats">
                    <div class="stat-item">
                        <span class="stat-number"><%= stats.users %></span>
                        <span class="stat-label">Happy Users</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number"><%= stats.products %></span>
                        <span class="stat-label">Products</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number"><%= stats.orders %></span>
                        <span class="stat-label">Orders Completed</span>
                    </div>
                </div>
                <div class="hero-cta">
                    <a href="/shop" class="btn-primary">Browse Shop</a>
                    <% if (!user) { %>
                        <a href="/auth/discord" class="btn-secondary">Join Now</a>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Featured Products -->
        <section class="featured-section">
            <div class="container">
                <h2 class="section-title">Featured Products</h2>
                <div class="products-grid">
                    <% featured.forEach(product => { %>
                        <div class="product-card glass-card">
                            <% if (product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
                            <% } else { %>
                                <div class="product-image-placeholder">
                                    <span>📦</span>
                                </div>
                            <% } %>
                            <div class="product-info">
                                <h3><%= product.name %></h3>
                                <p class="product-description"><%= product.description %></p>
                                <div class="product-price">
                                    <span class="price">₹<%= product.price.toFixed(2) %></span>
                                    <% if (product.stock < 10) { %>
                                        <span class="stock-low">Low stock</span>
                                    <% } %>
                                </div>
                                <% if (user) { %>
                                    <form action="/cart/add/<%= product.id %>" method="POST">
                                        <button type="submit" class="btn-add-to-cart">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                                            </svg>
                                            Add to Cart
                                        </button>
                                    </form>
                                <% } else { %>
                                    <a href="/auth/discord" class="btn-login-to-buy">Login to Buy</a>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="features-section">
            <div class="container">
                <h2 class="section-title">Why Choose Us</h2>
                <div class="features-grid">
                    <div class="feature-card glass-card">
                        <div class="feature-icon">⚡</div>
                        <h3>Instant Delivery</h3>
                        <p>Get your products immediately after payment approval</p>
                    </div>
                    <div class="feature-card glass-card">
                        <div class="feature-icon">🔒</div>
                        <h3>Secure Payments</h3>
                        <p>UPI QR code payments with proof upload system</p>
                    </div>
                    <div class="feature-card glass-card">
                        <div class="feature-icon">🎮</div>
                        <h3>Discord Integration</h3>
                        <p>Auto roles, order tracking, and 24/7 support</p>
                    </div>
                    <div class="feature-card glass-card">
                        <div class="feature-icon">💎</div>
                        <h3>Premium Quality</h3>
                        <p>Top-tier digital products and services</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-content glass-card">
                    <h2>Ready to get started?</h2>
                    <p>Join thousands of satisfied customers today</p>
                    <% if (!user) { %>
                        <a href="/auth/discord" class="btn-primary btn-large">Login with Discord</a>
                    <% } else { %>
                        <a href="/shop" class="btn-primary btn-large">Start Shopping</a>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <footer class="glass-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <span class="logo-imposter">IMPOSTER</span>
                    <span class="logo-network">NETWORK</span>
                    <p>Premium digital marketplace</p>
                </div>
                <div class="footer-links">
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/terms">Terms</a>
                    <a href="/history">History</a>
                </div>
                <div class="footer-copyright">
                    <p>Dev Rick • IMPOSTER Network © 2026-2027</p>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .login-success-message {
            position: fixed;
            top: 80px;
            right: 20px;
            background: rgba(0, 255, 0, 0.9);
            color: black;
            padding: 1rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            z-index: 1000;
            animation: slideIn 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 255, 0, 0.3);
        }
        
        .login-error-message {
            position: fixed;
            top: 80px;
            right: 20px;
            background: rgba(255, 0, 0, 0.9);
            color: white;
            padding: 1rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            z-index: 1000;
            animation: slideIn 0.3s ease;
            box-shadow: 0 4px 15px rgba(255, 0, 0, 0.3);
        }
        
        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
    </style>

    <script>
        async function updateCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                const data = await res.json();
                document.getElementById('cartCount').textContent = data.count;
            } catch (e) {
                console.error('Failed to update cart count');
            }
        }
        
        <% if (user) { %>
            updateCartCount();
            setInterval(updateCartCount, 30000);
        <% } %>
        
        // Auto-hide login messages after 5 seconds
        setTimeout(() => {
            const successMsg = document.querySelector('.login-success-message');
            const errorMsg = document.querySelector('.login-error-message');
            if (successMsg) {
                successMsg.style.transition = 'opacity 0.5s';
                successMsg.style.opacity = '0';
                setTimeout(() => successMsg.remove(), 500);
            }
            if (errorMsg) {
                errorMsg.style.transition = 'opacity 0.5s';
                errorMsg.style.opacity = '0';
                setTimeout(() => errorMsg.remove(), 500);
            }
        }, 5000);
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Premium Digital Marketplace</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <% include partials/navbar %>

    <!-- Login Success Message -->
    <% if (loginSuccess) { %>
        <div class="login-success-message">
            ✅ Successfully logged in! Welcome to IMPOSTER Network.
        </div>
    <% } %>
    
    <!-- Login Error Message -->
    <% if (loginError) { %>
        <div class="login-error-message">
            ❌ Login failed. Please try again.
        </div>
    <% } %>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">
                <span class="gradient-text">IMPOSTER</span> Network
            </h1>
            <p class="hero-subtitle">The ultimate digital marketplace with instant delivery and Discord integration</p>
            <div class="hero-stats">
                <div class="stat-item">
                    <span class="stat-number"><%= stats.users %></span>
                    <span class="stat-label">Happy Users</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><%= stats.products %></span>
                    <span class="stat-label">Products</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number"><%= stats.orders %></span>
                    <span class="stat-label">Orders Completed</span>
                </div>
            </div>
            <div class="hero-cta">
                <a href="/shop" class="btn-primary">Browse Shop</a>
                <% if (!user) { %>
                    <a href="/auth/discord" class="btn-secondary">Join Now</a>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <div class="container">
        <h2 class="section-title">Featured Products</h2>
        <div class="products-grid">
            <% featured.forEach(product => { %>
                <div class="product-card">
                    <% if (product.image) { %>
                        <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
                    <% } else { %>
                        <div class="product-image-placeholder">
                            <span>📦</span>
                        </div>
                    <% } %>
                    <div class="product-info">
                        <span class="product-category"><%= product.category %></span>
                        <h3><%= product.name %></h3>
                        <p class="product-description"><%= product.description %></p>
                        <div class="product-price">
                            <span class="price">₹<%= product.price.toFixed(2) %></span>
                            <% if (product.stock < 10) { %>
                                <span class="stock-low">Low stock</span>
                            <% } %>
                        </div>
                        <% if (user) { %>
                            <form action="/cart/add/<%= product.id %>" method="POST">
                                <button type="submit" class="btn-add-to-cart">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                                    </svg>
                                    Add to Cart
                                </button>
                            </form>
                        <% } else { %>
                            <a href="/auth/discord" class="btn-login-to-buy">Login to Buy</a>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Features Section -->
    <section class="features-section">
        <div class="container">
            <h2 class="section-title">Why Choose Us</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h3>Instant Delivery</h3>
                    <p>Get your products immediately after payment approval</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔒</div>
                    <h3>Secure Payments</h3>
                    <p>UPI QR code payments with proof upload system</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🎮</div>
                    <h3>Discord Integration</h3>
                    <p>Auto roles, order tracking, and 24/7 support</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">💎</div>
                    <h3>Premium Quality</h3>
                    <p>Top-tier digital products and services</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <div class="container" style="text-align: center; padding: 4rem 0;">
        <h2 style="font-size: 2rem; margin-bottom: 1rem;">Ready to get started?</h2>
        <p style="color: #999; margin-bottom: 2rem;">Join thousands of satisfied customers today</p>
        <% if (!user) { %>
            <a href="/auth/discord" class="btn-primary btn-large">Login with Discord</a>
        <% } else { %>
            <a href="/shop" class="btn-primary btn-large">Start Shopping</a>
        <% } %>
    </div>

    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
                <p>Premium digital marketplace</p>
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/terms">Terms</a>
                <a href="/history">History</a>
            </div>
            <div class="footer-copyright">
                <p>IMPOSTER Network © 2026-2027</p>
            </div>
        </div>
    </footer>

    <style>
        .login-success-message {
            position: fixed;
            top: 80px;
            right: 20px;
            background: rgba(0, 255, 0, 0.9);
            color: black;
            padding: 1rem 2rem;
            border-radius: 5px;
            z-index: 1000;
            animation: slideIn 0.3s ease;
        }
        
        .login-error-message {
            position: fixed;
            top: 80px;
            right: 20px;
            background: rgba(255, 0, 0, 0.9);
            color: white;
            padding: 1rem 2rem;
            border-radius: 5px;
            z-index: 1000;
            animation: slideIn 0.3s ease;
        }
        
        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        
        .section-title {
            font-size: 2rem;
            text-align: center;
            margin: 2rem 0 1rem;
            color: var(--primary);
        }
        
        .btn-large {
            padding: 1rem 3rem;
            font-size: 1.2rem;
        }
    </style>

    <script>
        // Auto-hide login messages after 5 seconds
        setTimeout(() => {
            const successMsg = document.querySelector('.login-success-message');
            const errorMsg = document.querySelector('.login-error-message');
            if (successMsg) {
                successMsg.style.transition = 'opacity 0.5s';
                successMsg.style.opacity = '0';
                setTimeout(() => successMsg.remove(), 500);
            }
            if (errorMsg) {
                errorMsg.style.transition = 'opacity 0.5s';
                errorMsg.style.opacity = '0';
                setTimeout(() => errorMsg.remove(), 500);
            }
        }, 5000);
    </script>
</body>
</html>

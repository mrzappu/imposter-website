<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Shopping Cart</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="glass-nav">
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/cart" class="active cart-link">
                    Cart
                    <span class="cart-badge" id="cartCount">0</span>
                </a>
                <a href="/history">History</a>
                <a href="/terms">Terms</a>
                <% if (user) { %>
                    <a href="/admin" style="<%= isAdmin ? '' : 'display:none;' %>" class="admin-link">Admin</a>
                    <div class="user-menu">
                        <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="user-avatar">
                        <span class="username"><%= user.username %></span>
                        <a href="/logout" class="logout-btn">Logout</a>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="discord-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515c-.209.377-.456.885-.624 1.3a18.277 18.277 0 0 0-5.487 0 12.64 12.64 0 0 0-.633-1.3 19.736 19.736 0 0 0-4.885 1.515c-2.86 4.27-3.636 8.432-3.208 12.502a20.11 20.11 0 0 0 6.066 2.98c.49-.664.926-1.383 1.302-2.14a13.193 13.193 0 0 1-2.052-.991c.173-.126.342-.258.506-.39a14.545 14.545 0 0 0 12.436 0c.165.132.334.264.507.39-.65.38-1.336.714-2.053.991.376.757.812 1.476 1.302 2.14a20.05 20.05 0 0 0 6.065-2.98c.506-4.587-.79-8.7-3.208-12.502zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419z"/>
                        </svg>
                        Login with Discord
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <main>
        <div class="shop-header">
            <div class="container">
                <h1 class="page-title">Shopping Cart</h1>
                <p class="page-subtitle">Review your items before checkout</p>
            </div>
        </div>

        <div class="container">
            <% if (!items || items.length === 0) { %>
                <div class="empty-cart glass-card">
                    <div class="empty-cart-icon">🛒</div>
                    <h2>Your cart is empty</h2>
                    <p>Looks like you haven't added anything to your cart yet.</p>
                    <a href="/shop" class="btn-primary">Browse Shop</a>
                </div>
            <% } else { %>
                <div class="cart-layout">
                    <div class="cart-items">
                        <% items.forEach(item => { %>
                            <div class="cart-item glass-card">
                                <div class="cart-item-image">
                                    <% if (item.image) { %>
                                        <img src="<%= item.image %>" alt="<%= item.name %>">
                                    <% } else { %>
                                        <div class="cart-item-image-placeholder">📦</div>
                                    <% } %>
                                </div>
                                <div class="cart-item-details">
                                    <h3><%= item.name %></h3>
                                    <p class="cart-item-price">$<%= item.price.toFixed(2) %></p>
                                    <p class="cart-item-description"><%= item.description %></p>
                                </div>
                                <div class="cart-item-actions">
                                    <form action="/cart/update/<%= item.cartId %>" method="POST" class="quantity-form">
                                        <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="99" class="quantity-input">
                                        <button type="submit" class="btn-update">Update</button>
                                    </form>
                                    <form action="/cart/remove/<%= item.cartId %>" method="POST">
                                        <button type="submit" class="btn-remove">Remove</button>
                                    </form>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="cart-summary glass-card">
                        <h2>Order Summary</h2>
                        <div class="summary-row">
                            <span>Subtotal:</span>
                            <span>$<%= subtotal.toFixed(2) %></span>
                        </div>
                        <div class="summary-row total">
                            <span>Total:</span>
                            <span>$<%= subtotal.toFixed(2) %></span>
                        </div>
                        <a href="/checkout" class="btn-checkout">Proceed to Checkout</a>
                        <a href="/shop" class="btn-continue-shopping">Continue Shopping</a>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="glass-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <span class="logo-imposter">IMPOSTER</span>
                    <span class="logo-network">NETWORK</span>
                    <p>Premium digital marketplace</p>
                </div>
                <div class="footer-links">
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/terms">Terms</a>
                    <a href="/history">History</a>
                </div>
                <div class="footer-copyright">
                    <p>Dev Rick • IMPOSTER Network © 2026-2027</p>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .empty-cart {
            text-align: center;
            padding: 4rem 2rem;
            max-width: 500px;
            margin: 2rem auto;
        }
        
        .empty-cart-icon {
            font-size: 5rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
        
        .empty-cart h2 {
            color: var(--primary);
            margin-bottom: 1rem;
        }
        
        .empty-cart p {
            color: var(--text-secondary);
            margin-bottom: 2rem;
        }
        
        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        
        .cart-item {
            display: flex;
            gap: 1.5rem;
            padding: 1.5rem;
            align-items: center;
        }
        
        .cart-item-image {
            width: 100px;
            height: 100px;
            flex-shrink: 0;
            border-radius: 8px;
            overflow: hidden;
            background: rgba(255,0,0,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .cart-item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .cart-item-image-placeholder {
            font-size: 2rem;
        }
        
        .cart-item-details {
            flex: 1;
        }
        
        .cart-item-details h3 {
            margin-bottom: 0.5rem;
            color: var(--primary);
        }
        
        .cart-item-price {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }
        
        .cart-item-description {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .cart-item-actions {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }
        
        .quantity-form {
            display: flex;
            gap: 0.3rem;
        }
        
        .quantity-input {
            width: 60px;
            padding: 0.5rem;
            background: rgba(0,0,0,0.3);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            color: white;
            text-align: center;
        }
        
        .btn-update {
            padding: 0.5rem 0.8rem;
            background: var(--warning);
            color: black;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        .btn-remove {
            padding: 0.5rem 0.8rem;
            background: var(--danger);
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        .cart-summary {
            padding: 1.5rem;
            height: fit-content;
            position: sticky;
            top: 100px;
        }
        
        .cart-summary h2 {
            margin-bottom: 1.5rem;
            color: var(--primary);
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 0.8rem 0;
            border-bottom: 1px solid var(--border-color);
        }
        
        .summary-row.total {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            border-bottom: none;
            margin-top: 1rem;
        }
        
        .btn-checkout {
            display: block;
            width: 100%;
            padding: 1rem;
            background: var(--primary);
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            margin: 1.5rem 0 0.5rem;
            transition: background 0.3s;
        }
        
        .btn-checkout:hover {
            background: var(--primary-dark);
        }
        
        .btn-continue-shopping {
            display: block;
            width: 100%;
            padding: 0.8rem;
            background: transparent;
            color: var(--text-secondary);
            text-align: center;
            text-decoration: none;
            border-radius: 6px;
            font-size: 0.9rem;
        }
        
        .btn-continue-shopping:hover {
            color: var(--primary);
        }
        
        @media (max-width: 768px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }
            
            .cart-item {
                flex-direction: column;
                text-align: center;
            }
            
            .cart-item-actions {
                flex-direction: column;
                width: 100%;
            }
            
            .quantity-form {
                width: 100%;
            }
            
            .quantity-input {
                flex: 1;
            }
        }
    </style>

    <script>
        async function updateCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                const data = await res.json();
                document.getElementById('cartCount').textContent = data.count;
            } catch (e) {
                console.error('Failed to update cart count');
            }
        }
        
        <% if (user) { %>
            updateCartCount();
            setInterval(updateCartCount, 30000);
        <% } %>
    </script>
</body>
</html>

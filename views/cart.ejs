<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Cart</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <div class="nav-container">
            <div class="logo">IMPOSTER</div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/cart">Cart</a>
                <a href="/history">History</a>
                <a href="/terms">Terms</a>
                <% if (user) { %>
                    <a href="/admin" style="<%= isAdmin ? '' : 'display:none;' %>">Admin</a>
                    <span class="user-greeting">Hi, <%= user.username %></span>
                    <a href="/logout">Logout</a>
                <% } else { %>
                    <a href="/auth/discord" class="discord-btn">Login with Discord</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="container">
        <h1>🛒 Your Cart</h1>
        <% if (items.length === 0) { %>
            <p>Your cart is empty. <a href="/shop">Go shopping</a></p>
        <% } else { %>
            <div class="cart-items">
                <% items.forEach(item => { %>
                    <div class="cart-item">
                        <div>
                            <h3><%= item.name %></h3>
                            <p>$<%= item.price.toFixed(2) %></p>
                        </div>
                        <form action="/cart/remove/<%= item.cartId %>" method="POST">
                            <button type="submit" class="remove-btn">Remove</button>
                        </form>
                    </div>
                <% }) %>
            </div>
            <div class="cart-total">
                <h3>Total: $<%= total.toFixed(2) %></h3>
                <a href="/pay" class="checkout-btn">Proceed to Checkout</a>
            </div>
        <% } %>
    </main>

    <footer>
        <p>Dev Rick • IMPOSTER Network © 2026-2027</p>
    </footer>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/cart" class="cart-link">
                    Cart
                    <span class="cart-badge" id="cartCount">0</span>
                </a>
                <a href="/history">History</a>
                <a href="/terms">Terms</a>
                <a href="/admin" class="active">Admin</a>
                <div class="user-menu">
                    <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="user-avatar">
                    <span class="username"><%= user.username %></span>
                    <a href="/logout" class="logout-btn">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <h1 class="page-title">Admin Panel</h1>
        
        <!-- Admin Navigation -->
        <div class="admin-nav">
            <a href="/admin" class="admin-nav-link <%= section === 'dashboard' ? 'active' : '' %>">Dashboard</a>
            <a href="/admin/products" class="admin-nav-link <%= section === 'products' ? 'active' : '' %>">Products</a>
            <a href="/admin/orders" class="admin-nav-link <%= section === 'orders' ? 'active' : '' %>">Orders</a>
            <a href="/admin/coupons" class="admin-nav-link <%= section === 'coupons' ? 'active' : '' %>">Coupons</a>
        </div>

        <!-- Dashboard Section -->
        <% if (section === 'dashboard') { %>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">👥</div>
                    <span class="stat-value"><%= stats.users %></span>
                    <span class="stat-label">Total Users</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📦</div>
                    <span class="stat-value"><%= stats.products %></span>
                    <span class="stat-label">Products</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📊</div>
                    <span class="stat-value"><%= stats.orders %></span>
                    <span class="stat-label">Total Orders</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⏳</div>
                    <span class="stat-value"><%= stats.pendingOrders %></span>
                    <span class="stat-label">Pending</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">✅</div>
                    <span class="stat-value"><%= stats.approvedOrders %></span>
                    <span class="stat-label">Approved</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">🏷️</div>
                    <span class="stat-value"><%= stats.coupons %></span>
                    <span class="stat-label">Coupons</span>
                </div>
            </div>

            <h2 style="color: var(--primary); margin: 2rem 0 1rem;">Recent Orders</h2>
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>User</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentOrders.length === 0) { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 2rem;">No orders yet</td>
                            </tr>
                        <% } else { %>
                            <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.id %></td>
                                    <td><%= order.username %></td>
                                    <td><%= order.itemCount || 0 %> items</td>
                                    <td>₹<%= order.total.toFixed(2) %></td>
                                    <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge status-<%= order.status %>">
                                            <%= order.status.toUpperCase() %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- Products Section -->
        <% if (section === 'products') { %>
            <div class="admin-header">
                <h2 style="color: var(--primary);">Manage Products</h2>
                <a href="/admin/products/add" class="btn-add">+ Add Product</a>
            </div>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Stock</th>
                            <th>Featured</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (products.length === 0) { %>
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem;">No products found</td>
                            </tr>
                        <% } else { %>
                            <% products.forEach(product => { %>
                                <tr>
                                    <td>#<%= product.id %></td>
                                    <td>
                                        <% if (product.image) { %>
                                            <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 40px; height: 40px; object-fit: cover; border-radius: 5px;">
                                        <% } else { %>
                                            📦
                                        <% } %>
                                    </td>
                                    <td><%= product.name %></td>
                                    <td>₹<%= product.price.toFixed(2) %></td>
                                    <td><%= product.category %></td>
                                    <td><%= product.stock %></td>
                                    <td><%= product.featured ? '⭐' : '' %></td>
                                    <td>
                                        <a href="/admin/products/edit/<%= product.id %>" style="color: var(--primary); margin-right: 0.5rem;">Edit</a>
                                        <form action="/admin/products/delete/<%= product.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this product?')">
                                            <button type="submit" style="background: none; border: none; color: var(--danger); cursor: pointer;">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- Orders Section -->
        <% if (section === 'orders') { %>
            <div class="admin-header">
                <h2 style="color: var(--primary);">Manage Orders</h2>
                <div style="display: flex; gap: 0.5rem;">
                    <a href="/admin/orders?status=all" style="color: <%= currentStatus === 'all' ? 'var(--primary)' : '#999' %>;">All</a>
                    <a href="/admin/orders?status=pending" style="color: <%= currentStatus === 'pending' ? 'var(--primary)' : '#999' %>;">Pending</a>
                    <a href="/admin/orders?status=approved" style="color: <%= currentStatus === 'approved' ? 'var(--primary)' : '#999' %>;">Approved</a>
                    <a href="/admin/orders?status=rejected" style="color: <%= currentStatus === 'rejected' ? 'var(--primary)' : '#999' %>;">Rejected</a>
                </div>
            </div>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>User</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length === 0) { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem;">No orders found</td>
                            </tr>
                        <% } else { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.id %></td>
                                    <td><%= order.username %></td>
                                    <td><%= order.itemCount || 0 %> items</td>
                                    <td>₹<%= order.total.toFixed(2) %></td>
                                    <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge status-<%= order.status %>">
                                            <%= order.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (order.status === 'pending') { %>
                                            <form action="/admin/orders/<%= order.id %>/approved" method="POST" style="display:inline;">
                                                <button type="submit" style="background: #00ff00; color: black; border: none; padding: 0.3rem 0.8rem; border-radius: 3px; cursor: pointer; margin-right: 0.3rem;">✓</button>
                                            </form>
                                            <form action="/admin/orders/<%= order.id %>/rejected" method="POST" style="display:inline;">
                                                <button type="submit" style="background: #ff0000; color: white; border: none; padding: 0.3rem 0.8rem; border-radius: 3px; cursor: pointer;">✗</button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- Coupons Section -->
        <% if (section === 'coupons') { %>
            <div class="admin-header">
                <h2 style="color: var(--primary);">Manage Coupons</h2>
                <a href="/admin/coupons/generate" class="btn-add">+ Generate</a>
            </div>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Value</th>
                            <th>Min Order</th>
                            <th>Uses</th>
                            <th>Expires</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (coupons.length === 0) { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem;">No coupons found</td>
                            </tr>
                        <% } else { %>
                            <% coupons.forEach(coupon => { %>
                                <tr>
                                    <td><strong style="color: var(--primary);"><%= coupon.code %></strong></td>
                                    <td><%= coupon.discount_type === 'percentage' ? '%' : '₹' %></td>
                                    <td><%= coupon.discount_value %><%= coupon.discount_type === 'percentage' ? '%' : '' %></td>
                                    <td>₹<%= coupon.min_order.toFixed(2) %></td>
                                    <td><%= coupon.used_count %>/<%= coupon.max_uses %></td>
                                    <td><%= coupon.expires_at ? new Date(coupon.expires_at).toLocaleDateString() : 'Never' %></td>
                                    <td>
                                        <form action="/admin/coupons/delete/<%= coupon.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this coupon?')">
                                            <button type="submit" style="background: none; border: none; color: var(--danger); cursor: pointer;">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- Coupon Form -->
        <% if (section === 'coupon-form') { %>
            <div style="background: #111; border: 1px solid #333; border-radius: 8px; padding: 2rem; max-width: 600px; margin: 0 auto;">
                <h2 style="color: var(--primary); margin-bottom: 1.5rem;">Generate Coupon</h2>
                <form action="/admin/coupons/generate" method="POST">
                    <div style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.3rem; color: #999;">Code (optional)</label>
                        <input type="text" name="custom_code" style="width: 100%; padding: 0.8rem; background: #1a1a1a; border: 1px solid #333; border-radius: 5px; color: white;">
                    </div>
                    
                    <div style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.3rem; color: #999;">Prefix</label>
                        <input type="text" name="code_prefix" style="width: 100%; padding: 0.8rem; background: #1a1a1a; border: 1px solid #333; border-radius: 5px; color: white;">
                    </div>
                    
                    <div style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.3rem; color: #999;">Discount Type</label>
                        <select name="discount_type" style="width: 100%; padding: 0.8rem; background: #1a1a1a; border: 1px solid #333; border-radius: 5px; color: white;">
                            <option value="percentage">Percentage (%)</option>
                            <option value="fixed">Fixed (₹)</option>
                        </select>
                    </div>
                    
                    <div style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.3rem; color: #999;">Discount Value</label>
                        <input type="number" name="discount_value" step="0.01" required style="width: 100%; padding: 0.8rem; background: #1a1a1a; border: 1px solid #333; border-radius: 5px; color: white;">
                    </div>
                    
                    <div style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.3rem; color: #999;">Minimum Order</label>
                        <input type="number" name="min_order" step="0.01" value="0" style="width: 100%; padding: 0.8rem; background: #1a1a1a; border: 1px solid #333; border-radius: 5px; color: white;">
                    </div>
                    
                    <div style="margin-bottom: 1rem;">
                        <label style="display: block; margin-bottom: 0.3rem; color: #999;">Max Uses</label>
                        <input type="number" name="max_uses" value="1" style="width: 100%; padding: 0.8rem; background: #1a1a1a; border: 1px solid #333; border-radius: 5px; color: white;">
                    </div>
                    
                    <div style="margin-bottom: 1.5rem;">
                        <label style="display: block; margin-bottom: 0.3rem; color: #999;">Expires After (days)</label>
                        <input type="number" name="expires_days" style="width: 100%; padding: 0.8rem; background: #1a1a1a; border: 1px solid #333; border-radius: 5px; color: white;">
                    </div>
                    
                    <button type="submit" class="btn-primary" style="width: 100%;">Generate</button>
                    <a href="/admin/coupons" style="display: block; text-align: center; margin-top: 1rem; color: #999;">Cancel</a>
                </form>
            </div>
        <% } %>
    </div>

    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
                <p>Premium digital marketplace</p>
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/terms">Terms</a>
                <a href="/history">History</a>
            </div>
            <div class="footer-copyright">
                <p>Dev Rick • IMPOSTER Network © 2026-2027</p>
            </div>
        </div>
    </footer>

    <script>
        async function updateCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                const data = await res.json();
                document.getElementById('cartCount').textContent = data.count;
            } catch (e) {}
        }
        
        <% if (user) { %>
            updateCartCount();
            setInterval(updateCartCount, 30000);
        <% } %>
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="glass-nav">
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/cart">Cart</a>
                <a href="/history">History</a>
                <a href="/terms">Terms</a>
                <a href="/admin" class="active">Admin</a>
                <div class="user-menu">
                    <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="user-avatar">
                    <span class="username"><%= user.username %></span>
                    <a href="/logout" class="logout-btn">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main>
        <div class="container">
            <h1 class="page-title">Admin Panel</h1>
            
            <!-- Admin Navigation -->
            <div class="admin-nav glass-card">
                <a href="/admin" class="admin-nav-link <%= section === 'dashboard' ? 'active' : '' %>">Dashboard</a>
                <a href="/admin/products" class="admin-nav-link <%= section === 'products' ? 'active' : '' %>">Products</a>
                <a href="/admin/orders" class="admin-nav-link <%= section === 'orders' ? 'active' : '' %>">Orders</a>
                <a href="/admin/coupons" class="admin-nav-link <%= section === 'coupons' ? 'active' : '' %>">Coupons</a>
            </div>

            <!-- Dashboard Section -->
            <% if (section === 'dashboard') { %>
                <div class="stats-grid">
                    <div class="stat-card glass-card">
                        <span class="stat-icon">👥</span>
                        <span class="stat-value"><%= stats.users %></span>
                        <span class="stat-label">Total Users</span>
                    </div>
                    <div class="stat-card glass-card">
                        <span class="stat-icon">📦</span>
                        <span class="stat-value"><%= stats.products %></span>
                        <span class="stat-label">Products</span>
                    </div>
                    <div class="stat-card glass-card">
                        <span class="stat-icon">📊</span>
                        <span class="stat-value"><%= stats.orders %></span>
                        <span class="stat-label">Total Orders</span>
                    </div>
                    <div class="stat-card glass-card">
                        <span class="stat-icon">⏳</span>
                        <span class="stat-value"><%= stats.pendingOrders %></span>
                        <span class="stat-label">Pending Orders</span>
                    </div>
                    <div class="stat-card glass-card">
                        <span class="stat-icon">🏷️</span>
                        <span class="stat-value"><%= stats.coupons %></span>
                        <span class="stat-label">Active Coupons</span>
                    </div>
                </div>

                <h2>Recent Orders</h2>
                <div class="admin-table glass-card">
                    <table>
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>User</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.id %></td>
                                    <td><%= order.username %></td>
                                    <td><%= JSON.parse(order.items).length %> items</td>
                                    <td>$<%= order.total.toFixed(2) %></td>
                                    <td><%= new Date(order.created_at).toLocaleString() %></td>
                                    <td>
                                        <span class="status-badge status-<%= order.status %>">
                                            <%= order.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/admin/orders?status=<%= order.status %>" class="btn-view">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <!-- Products Section -->
            <% if (section === 'products') { %>
                <div class="admin-header">
                    <h2>Manage Products</h2>
                    <a href="/admin/products/add" class="btn-add">+ Add New Product</a>
                </div>
                
                <div class="admin-table glass-card">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Category</th>
                                <th>Stock</th>
                                <th>Featured</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach(product => { %>
                                <tr>
                                    <td>#<%= product.id %></td>
                                    <td>
                                        <% if (product.image) { %>
                                            <img src="<%= product.image %>" alt="<%= product.name %>" class="product-thumb">
                                        <% } else { %>
                                            <span class="no-image">No image</span>
                                        <% } %>
                                    </td>
                                    <td><%= product.name %></td>
                                    <td>$<%= product.price.toFixed(2) %></td>
                                    <td><span class="category-badge"><%= product.category %></span></td>
                                    <td><%= product.stock %></td>
                                    <td>
                                        <% if (product.featured) { %>
                                            <span class="featured-badge">⭐</span>
                                        <% } %>
                                    </td>
                                    <td class="actions">
                                        <a href="/admin/products/edit/<%= product.id %>" class="btn-edit">Edit</a>
                                        <form action="/admin/products/delete/<%= product.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit" class="btn-delete">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <!-- Product Form Section -->
            <% if (section === 'product-form') { %>
                <div class="admin-form glass-card">
                    <h2><%= product ? 'Edit' : 'Add' %> Product</h2>
                    <form action="<%= product ? '/admin/products/edit/' + product.id : '/admin/products/add' %>" method="POST" enctype="multipart/form-data">
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="name">Product Name *</label>
                                <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="price">Price ($) *</label>
                                <input type="number" id="price" name="price" step="0.01" value="<%= product ? product.price : '' %>" required>
                            </div>
                            
                            <div class="form-group full-width">
                                <label for="description">Description</label>
                                <textarea id="description" name="description" rows="3"><%= product ? product.description : '' %></textarea>
                            </div>
                            
                            <div class="form-group">
                                <label for="category">Category</label>
                                <select id="category" name="category">
                                    <option value="general" <%= product && product.category === 'general' ? 'selected' : '' %>>General</option>
                                    <option value="membership" <%= product && product.category === 'membership' ? 'selected' : '' %>>Membership</option>
                                    <option value="digital" <%= product && product.category === 'digital' ? 'selected' : '' %>>Digital</option>
                                    <option value="service" <%= product && product.category === 'service' ? 'selected' : '' %>>Service</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="stock">Stock</label>
                                <input type="number" id="stock" name="stock" value="<%= product ? product.stock : 999 %>">
                            </div>
                            
                            <div class="form-group checkbox-group">
                                <label>
                                    <input type="checkbox" name="featured" <%= product && product.featured ? 'checked' : '' %>>
                                    Featured Product
                                </label>
                            </div>
                            
                            <div class="form-group full-width">
                                <label for="image">Product Image</label>
                                <input type="file" id="image" name="image" accept="image/png,image/jpeg,image/jpg">
                                <% if (product && product.image) { %>
                                    <p class="current-image">Current: <img src="<%= product.image %>" alt="current" class="current-image-preview"></p>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button type="submit" class="btn-save"><%= product ? 'Update' : 'Save' %> Product</button>
                            <a href="/admin/products" class="btn-cancel">Cancel</a>
                        </div>
                    </form>
                </div>
            <% } %>

            <!-- Orders Section -->
            <% if (section === 'orders') { %>
                <div class="admin-header">
                    <h2>Manage Orders</h2>
                    <div class="order-filters">
                        <a href="/admin/orders?status=all" class="filter-link <%= currentStatus === 'all' ? 'active' : '' %>">All</a>
                        <a href="/admin/orders?status=pending" class="filter-link <%= currentStatus === 'pending' ? 'active' : '' %>">Pending</a>
                        <a href="/admin/orders?status=approved" class="filter-link <%= currentStatus === 'approved' ? 'active' : '' %>">Approved</a>
                        <a href="/admin/orders?status=rejected" class="filter-link <%= currentStatus === 'rejected' ? 'active' : '' %>">Rejected</a>
                    </div>
                </div>
                
                <div class="admin-table glass-card">
                    <table>
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>User</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Coupon</th>
                                <th>Proof</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.id %></td>
                                    <td><%= order.username %></td>
                                    <td>
                                        <button class="btn-view-items" onclick="alert('<%= order.items %>')">View Items</button>
                                    </td>
                                    <td>$<%= order.total.toFixed(2) %></td>
                                    <td><%= order.coupon || '-' %></td>
                                    <td>
                                        <% if (order.proof) { %>
                                            <a href="/uploads/<%= order.proof %>" target="_blank" class="btn-view-proof">View</a>
                                        <% } %>
                                    </td>
                                    <td><%= new Date(order.created_at).toLocaleString() %></td>
                                    <td>
                                        <span class="status-badge status-<%= order.status %>">
                                            <%= order.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td class="actions">
                                        <% if (order.status === 'pending') { %>
                                            <form action="/admin/orders/<%= order.id %>/approved" method="POST" style="display:inline;">
                                                <button type="submit" class="btn-approve">Approve</button>
                                            </form>
                                            <form action="/admin/orders/<%= order.id %>/rejected" method="POST" style="display:inline;">
                                                <button type="submit" class="btn-reject">Reject</button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <!-- Coupons Section -->
            <% if (section === 'coupons') { %>
                <div class="admin-header">
                    <h2>Manage Coupons</h2>
                    <a href="/admin/coupons/generate" class="btn-add">+ Generate New Coupon</a>
                </div>
                
                <div class="admin-table glass-card">
                    <table>
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Type</th>
                                <th>Value</th>
                                <th>Min Order</th>
                                <th>Used</th>
                                <th>Max Uses</th>
                                <th>Expires</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% coupons.forEach(coupon => { %>
                                <tr>
                                    <td><strong><%= coupon.code %></strong></td>
                                    <td><%= coupon.discount_type === 'percentage' ? '%' : '$' %></td>
                                    <td><%= coupon.discount_value %><%= coupon.discount_type === 'percentage' ? '%' : '' %></td>
                                    <td>$<%= coupon.min_order.toFixed(2) %></td>
                                    <td><%= coupon.used_count %>/<%= coupon.max_uses %></td>
                                    <td><%= coupon.max_uses %></td>
                                    <td>
                                        <% if (coupon.expires_at) { %>
                                            <%= new Date(coupon.expires_at).toLocaleDateString() %>
                                        <% } else { %>
                                            Never
                                        <% } %>
                                    </td>
                                    <td class="actions">
                                        <form action="/admin/coupons/delete/<%= coupon.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this coupon?');">
                                            <button type="submit" class="btn-delete">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <!-- Coupon Form Section -->
            <% if (section === 'coupon-form') { %>
                <div class="admin-form glass-card">
                    <h2>Generate New Coupon</h2>
                    <form action="/admin/coupons/generate" method="POST">
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="custom_code">Custom Code (optional)</label>
                                <input type="text" id="custom_code" name="custom_code" placeholder="e.g., SUMMER2026">
                                <small>Leave empty for auto-generated</small>
                            </div>
                            
                            <div class="form-group">
                                <label for="code_prefix">Code Prefix (if auto-generate)</label>
                                <input type="text" id="code_prefix" name="code_prefix" placeholder="e.g., SAVE">
                            </div>
                            
                            <div class="form-group">
                                <label for="discount_type">Discount Type *</label>
                                <select id="discount_type" name="discount_type" required>
                                    <option value="percentage">Percentage (%)</option>
                                    <option value="fixed">Fixed Amount ($)</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="discount_value">Discount Value *</label>
                                <input type="number" id="discount_value" name="discount_value" step="0.01" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="min_order">Minimum Order ($)</label>
                                <input type="number" id="min_order" name="min_order" step="0.01" value="0">
                            </div>
                            
                            <div class="form-group">
                                <label for="max_uses">Maximum Uses</label>
                                <input type="number" id="max_uses" name="max_uses" value="1">
                            </div>
                            
                            <div class="form-group">
                                <label for="expires_days">Expires After (days)</label>
                                <input type="number" id="expires_days" name="expires_days" placeholder="Leave empty for no expiry">
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button type="submit" class="btn-save">Generate Coupon</button>
                            <a href="/admin/coupons" class="btn-cancel">Cancel</a>
                        </div>
                    </form>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="glass-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <span class="logo-imposter">IMPOSTER</span>
                    <span class="logo-network">NETWORK</span>
                    <p>Premium digital marketplace</p>
                </div>
                <div class="footer-links">
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/terms">Terms</a>
                    <a href="/history">History</a>
                </div>
                <div class="footer-copyright">
                    <p>Dev Rick • IMPOSTER Network © 2026-2027</p>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>

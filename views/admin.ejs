<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================== NAVBAR (EMBEDDED DIRECTLY) ==================== -->
    <nav>
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a>
                <a href="/shop" class="<%= currentPage === 'shop' ? 'active' : '' %>">Shop</a>
                <a href="/cart" class="cart-link <%= currentPage === 'cart' ? 'active' : '' %>">
                    Cart
                    <span class="cart-badge" id="cartCount">0</span>
                </a>
                <a href="/history" class="<%= currentPage === 'history' ? 'active' : '' %>">History</a>
                <a href="/terms" class="<%= currentPage === 'terms' ? 'active' : '' %>">Terms</a>
                
                <% if (user) { %>
                    <a href="/admin" class="<%= currentPage === 'admin' ? 'active' : '' %>">Admin</a>
                    
                    <!-- Profile Menu with Dropdown -->
                    <div class="profile-container">
                        <div class="profile-trigger">
                            <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" 
                                 alt="avatar" 
                                 class="profile-avatar">
                            <span class="profile-name"><%= user.username %></span>
                        </div>
                        
                        <div class="profile-dropdown">
                            <div class="profile-header">
                                <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" 
                                     alt="avatar" 
                                     class="profile-header-avatar">
                                <div class="profile-header-info">
                                    <h4><%= user.username %></h4>
                                    <p>ID: <%= user.id.substring(0, 8) %>...</p>
                                </div>
                            </div>
                            
                            <a href="/profile" class="profile-menu-item">
                                <span>👤</span> My Profile
                            </a>
                            <a href="/history" class="profile-menu-item">
                                <span>📜</span> My Orders
                            </a>
                            <a href="/settings" class="profile-menu-item">
                                <span>⚙️</span> Settings
                            </a>
                            <a href="/logout" class="profile-menu-item logout">
                                <span>🚪</span> Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="discord-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515c-.209.377-.456.885-.624 1.3a18.277 18.277 0 0 0-5.487 0 12.64 12.64 0 0 0-.633-1.3 19.736 19.736 0 0 0-4.885 1.515c-2.86 4.27-3.636 8.432-3.208 12.502a20.11 20.11 0 0 0 6.066 2.98c.49-.664.926-1.383 1.302-2.14a13.193 13.193 0 0 1-2.052-.991c.173-.126.342-.258.506-.39a14.545 14.545 0 0 0 12.436 0c.165.132.334.264.507.39-.65.38-1.336.714-2.053.991.376.757.812 1.476 1.302 2.14a20.05 20.05 0 0 0 6.065-2.98c.506-4.587-.79-8.7-3.208-12.502zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419z"/>
                        </svg>
                        Login with Discord
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <style>
        /* Profile Menu Styles */
        .profile-container {
            position: relative;
            display: inline-block;
        }
        
        .profile-trigger {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.3rem;
            border-radius: 40px;
            transition: background 0.3s;
        }
        
        .profile-trigger:hover {
            background: rgba(255, 0, 0, 0.1);
        }
        
        .profile-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid #ff0000;
            object-fit: cover;
        }
        
        .profile-name {
            font-weight: 600;
            color: white;
            max-width: 120px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .profile-dropdown {
            position: absolute;
            top: 50px;
            right: 0;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 10px;
            width: 250px;
            padding: 1rem;
            display: none;
            z-index: 1000;
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
        }
        
        .profile-container:hover .profile-dropdown {
            display: block;
        }
        
        .profile-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #333;
            margin-bottom: 0.5rem;
        }
        
        .profile-header-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid #ff0000;
        }
        
        .profile-header-info h4 {
            color: white;
            margin-bottom: 0.2rem;
        }
        
        .profile-header-info p {
            color: #999;
            font-size: 0.8rem;
        }
        
        .profile-menu-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.8rem;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            transition: background 0.3s;
        }
        
        .profile-menu-item:hover {
            background: rgba(255, 0, 0, 0.1);
            color: #ff0000;
        }
        
        .profile-menu-item.logout {
            border-top: 1px solid #333;
            margin-top: 0.5rem;
            padding-top: 1rem;
            color: #ff0000;
        }
        
        .profile-menu-item.logout:hover {
            background: rgba(255, 0, 0, 0.2);
        }
        
        /* Discord Button */
        .discord-btn {
            background: #5865F2;
            color: white !important;
            padding: 0.6rem 1.5rem !important;
            border-radius: 30px !important;
            display: flex !important;
            align-items: center;
            gap: 0.5rem;
            transition: background 0.3s;
            font-weight: 600 !important;
            border: none !important;
        }
        
        .discord-btn:hover {
            background: #4752c4 !important;
            color: white !important;
        }
        
        .discord-btn svg {
            fill: white;
            width: 18px;
            height: 18px;
        }
        
        /* Cart Badge */
        .cart-link {
            position: relative;
        }
        
        .cart-badge {
            position: absolute;
            top: -8px;
            right: -12px;
            background: #ff0000;
            color: white;
            font-size: 0.7rem;
            font-weight: bold;
            min-width: 18px;
            height: 18px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            box-shadow: 0 0 10px rgba(255,0,0,0.5);
        }
        
        /* Active Link */
        .nav-links a.active {
            color: #ff0000;
        }
        
        /* Admin Panel Styles */
        .admin-nav {
            background: #111;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }
        
        .admin-nav-link {
            padding: 0.5rem 1.5rem;
            border-radius: 5px;
            color: white;
            text-decoration: none;
            transition: all 0.3s;
        }
        
        .admin-nav-link:hover,
        .admin-nav-link.active {
            background: #ff0000;
            color: white;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .stat-card {
            background: #111;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 1.5rem;
            text-align: center;
        }
        
        .stat-icon {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }
        
        .stat-value {
            display: block;
            font-size: 2rem;
            font-weight: 700;
            color: #ff0000;
        }
        
        .stat-label {
            color: #999;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }
        
        .btn-add {
            padding: 0.6rem 1.2rem;
            background: #ff0000;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 600;
            transition: background 0.3s;
        }
        
        .btn-add:hover {
            background: #cc0000;
        }
        
        .admin-table {
            background: #111;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 1rem;
            overflow-x: auto;
            margin-bottom: 2rem;
        }
        
        .admin-table table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }
        
        .admin-table th {
            text-align: left;
            padding: 1rem;
            background: #1a1a1a;
            color: #ff0000;
            font-weight: 600;
            border-bottom: 2px solid #333;
        }
        
        .admin-table td {
            padding: 1rem;
            border-bottom: 1px solid #333;
            color: #999;
        }
        
        .product-thumb {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 4px;
        }
        
        .category-badge {
            background: rgba(255, 0, 0, 0.1);
            color: #ff0000;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.8rem;
        }
        
        .featured-badge {
            color: gold;
            font-size: 1.2rem;
        }
        
        .actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .btn-edit, .btn-delete, .btn-view, .btn-approve, .btn-reject {
            padding: 0.3rem 0.8rem;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 0.8rem;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-edit, .btn-view {
            background: #ffaa00;
            color: black;
        }
        
        .btn-delete, .btn-reject {
            background: #ff0000;
            color: white;
        }
        
        .btn-approve {
            background: #00ff00;
            color: black;
        }
        
        .order-filters {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .filter-link {
            padding: 0.3rem 0.8rem;
            border-radius: 3px;
            color: white;
            text-decoration: none;
            background: rgba(255, 0, 0, 0.1);
        }
        
        .filter-link.active,
        .filter-link:hover {
            background: #ff0000;
        }
        
        .status-badge {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        .status-pending {
            background: rgba(255, 170, 0, 0.2);
            color: #ffaa00;
            border: 1px solid #ffaa00;
        }
        
        .status-approved {
            background: rgba(0, 255, 0, 0.2);
            color: #00ff00;
            border: 1px solid #00ff00;
        }
        
        .status-rejected {
            background: rgba(255, 0, 0, 0.2);
            color: #ff0000;
            border: 1px solid #ff0000;
        }
        
        .btn-view-proof {
            padding: 0.2rem 0.5rem;
            background: #ff0000;
            color: white;
            text-decoration: none;
            border-radius: 3px;
            font-size: 0.8rem;
        }
        
        .no-proof {
            color: #666;
            font-size: 0.8rem;
            font-style: italic;
        }
        
        .coupon-code {
            color: #ff0000;
            font-family: monospace;
            font-size: 1rem;
        }
        
        /* Admin Form Styles */
        .admin-form {
            max-width: 600px;
            margin: 0 auto;
            background: #111;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 2rem;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: #999;
        }
        
        .form-group input[type="text"],
        .form-group input[type="number"],
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 0.8rem;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 5px;
            color: white;
        }
        
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #ff0000;
        }
        
        .form-group input[type="checkbox"] {
            margin-right: 0.5rem;
        }
        
        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }
        
        .form-actions button {
            padding: 0.8rem 2rem;
            background: #ff0000;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        
        .form-actions a {
            padding: 0.8rem 2rem;
            color: #999;
            text-decoration: none;
        }
        
        .alert {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 5px;
            text-align: center;
            animation: slideDown 0.3s ease;
        }
        
        .alert-success {
            background: rgba(0, 255, 0, 0.1);
            border: 1px solid #00ff00;
            color: #00ff00;
        }
        
        .alert-error {
            background: rgba(255, 0, 0, 0.1);
            border: 1px solid #ff0000;
            color: #ff0000;
        }
        
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @media (max-width: 768px) {
            .admin-nav {
                flex-direction: column;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
            
            .admin-header {
                flex-direction: column;
            }
        }
    </style>

    <script>
        // Cart count updater
        async function updateCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                const data = await res.json();
                const badge = document.getElementById('cartCount');
                if (badge) badge.textContent = data.count;
            } catch (e) {}
        }
        
        <% if (user) { %>
            updateCartCount();
            setInterval(updateCartCount, 30000);
        <% } %>
        
        // Profile dropdown handlers
        document.querySelectorAll('.profile-container').forEach(container => {
            container.addEventListener('mouseenter', function() {
                const dropdown = this.querySelector('.profile-dropdown');
                if (dropdown) dropdown.style.display = 'block';
            });
            
            container.addEventListener('mouseleave', function() {
                const dropdown = this.querySelector('.profile-dropdown');
                if (dropdown) dropdown.style.display = 'none';
            });
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const dropdowns = document.querySelectorAll('.profile-dropdown');
            const triggers = document.querySelectorAll('.profile-trigger');
            
            dropdowns.forEach((dropdown, index) => {
                if (!dropdown.contains(e.target) && !triggers[index].contains(e.target)) {
                    dropdown.style.display = 'none';
                }
            });
        });
        
        // Confirm delete
        function confirmDelete(productName) {
            return confirm(`⚠️ Are you sure you want to delete "${productName}"?\n\nThis action cannot be undone!`);
        }
    </script>

    <div class="container">
        <h1 class="page-title">Admin Panel</h1>
        
        <!-- Admin Navigation -->
        <div class="admin-nav">
            <a href="/admin" class="admin-nav-link <%= section === 'dashboard' ? 'active' : '' %>">Dashboard</a>
            <a href="/admin/products" class="admin-nav-link <%= section === 'products' ? 'active' : '' %>">Products</a>
            <a href="/admin/orders" class="admin-nav-link <%= section === 'orders' ? 'active' : '' %>">Orders</a>
            <a href="/admin/coupons" class="admin-nav-link <%= section === 'coupons' ? 'active' : '' %>">Coupons</a>
        </div>

        <!-- ==================== DASHBOARD SECTION ==================== -->
        <% if (section === 'dashboard') { %>
            <!-- Success/Error Messages -->
            <% if (query && query.success === 'deleted') { %>
                <div class="alert alert-success">✅ Item deleted successfully!</div>
            <% } %>
            <% if (query && query.error) { %>
                <div class="alert alert-error">❌ Error: <%= query.error %></div>
            <% } %>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">👥</div>
                    <span class="stat-value"><%= stats.users %></span>
                    <span class="stat-label">Total Users</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📦</div>
                    <span class="stat-value"><%= stats.products %></span>
                    <span class="stat-label">Products</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">📊</div>
                    <span class="stat-value"><%= stats.orders %></span>
                    <span class="stat-label">Total Orders</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⏳</div>
                    <span class="stat-value"><%= stats.pendingOrders %></span>
                    <span class="stat-label">Pending</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">✅</div>
                    <span class="stat-value"><%= stats.approvedOrders %></span>
                    <span class="stat-label">Approved</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">🏷️</div>
                    <span class="stat-value"><%= stats.coupons %></span>
                    <span class="stat-label">Coupons</span>
                </div>
            </div>

            <h2 style="color: #ff0000; margin: 2rem 0 1rem;">Recent Orders</h2>
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>User</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!recentOrders || recentOrders.length === 0) { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem;">No orders yet</td>
                            </tr>
                        <% } else { %>
                            <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.id %></td>
                                    <td><%= order.username %></td>
                                    <td><%= order.itemCount || 0 %> items</td>
                                    <td>₹<%= order.total.toFixed(2) %></td>
                                    <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge status-<%= order.status %>">
                                            <%= order.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/admin/orders?status=<%= order.status %>" class="btn-view">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- ==================== PRODUCTS SECTION ==================== -->
        <% if (section === 'products') { %>
            <div class="admin-header">
                <h2 style="color: #ff0000;">Manage Products</h2>
                <a href="/admin/products/add" class="btn-add">+ Add New Product</a>
            </div>
            
            <!-- Success/Error Messages -->
            <% if (query && query.success === 'added') { %>
                <div class="alert alert-success">✅ Product added successfully!</div>
            <% } %>
            <% if (query && query.success === 'updated') { %>
                <div class="alert alert-success">✅ Product updated successfully!</div>
            <% } %>
            <% if (query && query.success === 'deleted') { %>
                <div class="alert alert-success">✅ Product deleted successfully!</div>
            <% } %>
            <% if (query && query.success === 'deleted_soft') { %>
                <div class="alert alert-success">✅ Product hidden (exists in orders)</div>
            <% } %>
            <% if (query && query.error) { %>
                <div class="alert alert-error">❌ Error: <%= query.error %></div>
            <% } %>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Stock</th>
                            <th>Featured</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!products || products.length === 0) { %>
                            <tr>
                                <td colspan="8" style="text-align: center; padding: 2rem;">
                                    No products found. <a href="/admin/products/add">Add your first product</a>
                                </td>
                            </tr>
                        <% } else { %>
                            <% products.forEach(product => { %>
                                <tr>
                                    <td>#<%= product.id %></td>
                                    <td>
                                        <% if (product.image) { %>
                                            <img src="<%= product.image %>" alt="<%= product.name %>" class="product-thumb">
                                        <% } else { %>
                                            <span style="font-size: 1.5rem;">📦</span>
                                        <% } %>
                                    </td>
                                    <td><%= product.name %></td>
                                    <td>₹<%= product.price.toFixed(2) %></td>
                                    <td><span class="category-badge"><%= product.category %></span></td>
                                    <td><%= product.stock %></td>
                                    <td><%= product.featured ? '⭐' : '' %></td>
                                    <td class="actions">
                                        <a href="/admin/products/edit/<%= product.id %>" class="btn-edit">Edit</a>
                                        <form action="/admin/products/delete/<%= product.id %>" method="POST" style="display:inline;" onsubmit="return confirmDelete('<%= product.name.replace(/'/g, "\\'") %>')">
                                            <button type="submit" class="btn-delete">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- ==================== PRODUCT FORM SECTION (ADD/EDIT) ==================== -->
        <% if (section === 'product-form') { %>
            <div class="admin-form">
                <h2 style="color: #ff0000; margin-bottom: 1.5rem;"><%= product ? 'Edit Product' : 'Add New Product' %></h2>
                
                <form action="<%= product ? '/admin/products/edit/' + product.id : '/admin/products/add' %>" 
                      method="POST" 
                      enctype="multipart/form-data">
                    
                    <div class="form-group">
                        <label for="name">Product Name *</label>
                        <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="price">Price (₹) *</label>
                        <input type="number" id="price" name="price" step="0.01" min="0" value="<%= product ? product.price : '' %>" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="4"><%= product ? product.description : '' %></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="category">Category</label>
                        <select id="category" name="category">
                            <option value="general" <%= product && product.category === 'general' ? 'selected' : '' %>>General</option>
                            <option value="membership" <%= product && product.category === 'membership' ? 'selected' : '' %>>Membership</option>
                            <option value="digital" <%= product && product.category === 'digital' ? 'selected' : '' %>>Digital</option>
                            <option value="service" <%= product && product.category === 'service' ? 'selected' : '' %>>Service</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="stock">Stock</label>
                        <input type="number" id="stock" name="stock" min="0" value="<%= product ? product.stock : 999 %>">
                    </div>
                    
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="featured" <%= product && product.featured ? 'checked' : '' %>> 
                            Featured Product
                        </label>
                    </div>
                    
                    <div class="form-group">
                        <label for="image">Product Image</label>
                        <input type="file" id="image" name="image" accept="image/png,image/jpeg,image/jpg">
                        <% if (product && product.image) { %>
                            <div style="margin-top: 0.5rem;">
                                <p style="color: #999; margin-bottom: 0.3rem;">Current Image:</p>
                                <img src="<%= product.image %>" alt="<%= product.name %>" style="max-width: 100px; border-radius: 5px;">
                            </div>
                        <% } %>
                        <small style="color: #666;">Leave empty to keep current image</small>
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="btn-primary"><%= product ? 'Update' : 'Add' %> Product</button>
                        <a href="/admin/products">Cancel</a>
                    </div>
                </form>
            </div>
        <% } %>

        <!-- ==================== ORDERS SECTION ==================== -->
        <% if (section === 'orders') { %>
            <div class="admin-header">
                <h2 style="color: #ff0000;">Manage Orders</h2>
                <div class="order-filters">
                    <a href="/admin/orders?status=all" class="filter-link <%= currentStatus === 'all' ? 'active' : '' %>">All</a>
                    <a href="/admin/orders?status=pending" class="filter-link <%= currentStatus === 'pending' ? 'active' : '' %>">Pending</a>
                    <a href="/admin/orders?status=approved" class="filter-link <%= currentStatus === 'approved' ? 'active' : '' %>">Approved</a>
                    <a href="/admin/orders?status=rejected" class="filter-link <%= currentStatus === 'rejected' ? 'active' : '' %>">Rejected</a>
                </div>
            </div>
            
            <!-- Success/Error Messages -->
            <% if (query && query.success) { %>
                <div class="alert alert-success">✅ Order updated successfully!</div>
            <% } %>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>User</th>
                            <th>Items</th>
                            <th>Subtotal</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Coupon</th>
                            <th>Proof</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!orders || orders.length === 0) { %>
                            <tr>
                                <td colspan="11" style="text-align: center; padding: 2rem;">No orders found</td>
                            </tr>
                        <% } else { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td>#<%= order.id %></td>
                                    <td><%= order.username %></td>
                                    <td>
                                        <button class="btn-view" onclick="alert('<%= order.items %>')">View</button>
                                    </td>
                                    <td>₹<%= order.subtotal.toFixed(2) %></td>
                                    <td>₹<%= order.discount.toFixed(2) %></td>
                                    <td><strong>₹<%= order.total.toFixed(2) %></strong></td>
                                    <td><%= order.coupon || '-' %></td>
                                    <td>
                                        <% if (order.proof) { %>
                                            <a href="/uploads/<%= order.proof %>" target="_blank" class="btn-view-proof">View</a>
                                        <% } else { %>
                                            <span class="no-proof">No proof</span>
                                        <% } %>
                                    </td>
                                    <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <span class="status-badge status-<%= order.status %>">
                                            <%= order.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td class="actions">
                                        <% if (order.status === 'pending') { %>
                                            <form action="/admin/orders/<%= order.id %>/approved" method="POST" style="display:inline;">
                                                <button type="submit" class="btn-approve" onclick="return confirm('Approve this order?')">Approve</button>
                                            </form>
                                            <form action="/admin/orders/<%= order.id %>/rejected" method="POST" style="display:inline;">
                                                <button type="submit" class="btn-reject" onclick="return confirm('Reject this order?')">Reject</button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- ==================== COUPONS SECTION ==================== -->
        <% if (section === 'coupons') { %>
            <div class="admin-header">
                <h2 style="color: #ff0000;">Manage Coupons</h2>
                <a href="/admin/coupons/generate" class="btn-add">+ Generate New Coupon</a>
            </div>
            
            <!-- Success/Error Messages -->
            <% if (query && query.success === 'generated') { %>
                <div class="alert alert-success">✅ Coupon generated successfully!</div>
            <% } %>
            <% if (query && query.success === 'deleted') { %>
                <div class="alert alert-success">✅ Coupon deleted successfully!</div>
            <% } %>
            <% if (query && query.error) { %>
                <div class="alert alert-error">❌ Error: <%= query.error %></div>
            <% } %>
            
            <div class="admin-table">
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Value</th>
                            <th>Min Order</th>
                            <th>Used</th>
                            <th>Max Uses</th>
                            <th>Expires</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!coupons || coupons.length === 0) { %>
                            <tr>
                                <td colspan="9" style="text-align: center; padding: 2rem;">
                                    No coupons found. <a href="/admin/coupons/generate">Generate your first coupon</a>
                                </td>
                            </tr>
                        <% } else { %>
                            <% coupons.forEach(coupon => { %>
                                <tr>
                                    <td><strong class="coupon-code"><%= coupon.code %></strong></td>
                                    <td><%= coupon.discount_type === 'percentage' ? '%' : '₹' %></td>
                                    <td><%= coupon.discount_value %><%= coupon.discount_type === 'percentage' ? '%' : '' %></td>
                                    <td>₹<%= coupon.min_order.toFixed(2) %></td>
                                    <td><%= coupon.used_count %>/<%= coupon.max_uses %></td>
                                    <td><%= coupon.max_uses %></td>
                                    <td>
                                        <% if (coupon.expires_at) { %>
                                            <%= new Date(coupon.expires_at).toLocaleDateString() %>
                                        <% } else { %>
                                            Never
                                        <% } %>
                                    </td>
                                    <td><%= new Date(coupon.created_at).toLocaleDateString() %></td>
                                    <td class="actions">
                                        <form action="/admin/coupons/delete/<%= coupon.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this coupon?')">
                                            <button type="submit" class="btn-delete">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- ==================== COUPON FORM SECTION ==================== -->
        <% if (section === 'coupon-form') { %>
            <div class="admin-form">
                <h2 style="color: #ff0000; margin-bottom: 1.5rem;">Generate New Coupon</h2>
                
                <form action="/admin/coupons/generate" method="POST">
                    <div class="form-group">
                        <label for="custom_code">Custom Code (optional)</label>
                        <input type="text" id="custom_code" name="custom_code" placeholder="e.g., SUMMER2026">
                    </div>
                    
                    <div class="form-group">
                        <label for="code_prefix">Prefix (if auto-generate)</label>
                        <input type="text" id="code_prefix" name="code_prefix" placeholder="e.g., SAVE">
                    </div>
                    
                    <div class="form-group">
                        <label for="discount_type">Discount Type *</label>
                        <select id="discount_type" name="discount_type" required>
                            <option value="percentage">Percentage (%)</option>
                            <option value="fixed">Fixed Amount (₹)</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="discount_value">Discount Value *</label>
                        <input type="number" id="discount_value" name="discount_value" step="0.01" min="0" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="min_order">Minimum Order (₹)</label>
                        <input type="number" id="min_order" name="min_order" step="0.01" min="0" value="0">
                    </div>
                    
                    <div class="form-group">
                        <label for="max_uses">Maximum Uses</label>
                        <input type="number" id="max_uses" name="max_uses" min="1" value="1">
                    </div>
                    
                    <div class="form-group">
                        <label for="expires_days">Expires After (days)</label>
                        <input type="number" id="expires_days" name="expires_days" min="1" placeholder="Leave empty for no expiry">
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="btn-primary">Generate Coupon</button>
                        <a href="/admin/coupons">Cancel</a>
                    </div>
                </form>
            </div>
        <% } %>
    </div>

    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
                <p>Premium digital marketplace</p>
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/terms">Terms</a>
                <a href="/history">History</a>
            </div>
            <div class="footer-copyright">
                <p>IMPOSTER Network © 2026-2027</p>
            </div>
        </div>
    </footer>
</body>
</html>

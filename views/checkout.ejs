<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMPOSTER Network – Checkout</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================== NAVBAR (EMBEDDED DIRECTLY) ==================== -->
    <nav>
        <div class="nav-container">
            <div class="logo">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
            </div>
            <div class="nav-links">
                <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a>
                <a href="/shop" class="<%= currentPage === 'shop' ? 'active' : '' %>">Shop</a>
                <a href="/cart" class="cart-link <%= currentPage === 'cart' ? 'active' : '' %>">
                    Cart
                    <span class="cart-badge" id="cartCount">0</span>
                </a>
                <a href="/history" class="<%= currentPage === 'history' ? 'active' : '' %>">History</a>
                <a href="/terms" class="<%= currentPage === 'terms' ? 'active' : '' %>">Terms</a>
                
                <% if (user) { %>
                    <a href="/admin" style="<%= isAdmin ? '' : 'display:none;' %>" class="<%= currentPage === 'admin' ? 'active' : '' %>">Admin</a>
                    
                    <div class="profile-container">
                        <div class="profile-trigger">
                            <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="profile-avatar">
                            <span class="profile-name"><%= user.username %></span>
                        </div>
                        <div class="profile-dropdown">
                            <div class="profile-header">
                                <img src="<%= user.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="avatar" class="profile-header-avatar">
                                <div class="profile-header-info">
                                    <h4><%= user.username %></h4>
                                    <p>ID: <%= user.id.substring(0, 8) %>...</p>
                                </div>
                            </div>
                            <a href="/profile" class="profile-menu-item">👤 My Profile</a>
                            <a href="/history" class="profile-menu-item">📜 My Orders</a>
                            <a href="/settings" class="profile-menu-item">⚙️ Settings</a>
                            <a href="/logout" class="profile-menu-item logout">🚪 Logout</a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="discord-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515c-.209.377-.456.885-.624 1.3a18.277 18.277 0 0 0-5.487 0 12.64 12.64 0 0 0-.633-1.3 19.736 19.736 0 0 0-4.885 1.515c-2.86 4.27-3.636 8.432-3.208 12.502a20.11 20.11 0 0 0 6.066 2.98c.49-.664.926-1.383 1.302-2.14a13.193 13.193 0 0 1-2.052-.991c.173-.126.342-.258.506-.39a14.545 14.545 0 0 0 12.436 0c.165.132.334.264.507.39-.65.38-1.336.714-2.053.991.376.757.812 1.476 1.302 2.14a20.05 20.05 0 0 0 6.065-2.98c.506-4.587-.79-8.7-3.208-12.502zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.947-2.419 2.157-2.419 1.21 0 2.184 1.086 2.157 2.419 0 1.334-.947 2.419-2.157 2.419z"/>
                        </svg>
                        Login
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <style>
        .profile-container { position: relative; display: inline-block; }
        .profile-trigger { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; padding: 0.3rem; border-radius: 40px; }
        .profile-avatar { width: 40px; height: 40px; border-radius: 50%; border: 2px solid #ff0000; }
        .profile-name { font-weight: 600; color: white; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .profile-dropdown { position: absolute; top: 50px; right: 0; background: #1a1a1a; border: 1px solid #333; border-radius: 10px; width: 250px; padding: 1rem; display: none; z-index: 1000; }
        .profile-container:hover .profile-dropdown { display: block; }
        .profile-header { display: flex; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #333; }
        .profile-header-avatar { width: 50px; height: 50px; border-radius: 50%; border: 2px solid #ff0000; }
        .profile-menu-item { display: flex; align-items: center; gap: 0.8rem; padding: 0.8rem; color: white; text-decoration: none; }
        .profile-menu-item:hover { background: rgba(255,0,0,0.1); color: #ff0000; }
        .profile-menu-item.logout { border-top: 1px solid #333; margin-top: 0.5rem; color: #ff0000; }
        .discord-btn { background: #5865F2; color: white !important; padding: 0.6rem 1.5rem !important; border-radius: 30px !important; display: flex !important; align-items: center; gap: 0.5rem; }
        .cart-link { position: relative; }
        .cart-badge { position: absolute; top: -8px; right: -12px; background: #ff0000; color: white; font-size: 0.7rem; min-width: 18px; height: 18px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0 4px; }
        .nav-links a.active { color: #ff0000; }
    </style>

    <script>
        async function updateCartCount() {
            try {
                const res = await fetch('/api/cart/count');
                const data = await res.json();
                document.getElementById('cartCount').textContent = data.count;
            } catch (e) {}
        }
        <% if (user) { %>
            updateCartCount();
            setInterval(updateCartCount, 30000);
        <% } %>
    </script>

    <div class="shop-header">
        <div class="container">
            <h1 class="page-title">Checkout</h1>
            <p class="page-subtitle">Complete your payment</p>
        </div>
    </div>

    <div class="container">
        <div class="checkout-layout">
            <!-- Order Summary -->
            <div class="order-summary">
                <h2>Order Summary</h2>
                <div class="order-items">
                    <% items.forEach(item => { %>
                        <div class="order-item">
                            <span><%= item.quantity %>x <%= item.name %></span>
                            <span>₹<%= (item.price * item.quantity).toFixed(2) %></span>
                        </div>
                    <% }) %>
                </div>
                
                <div class="order-totals">
                    <div class="total-row">
                        <span>Subtotal:</span>
                        <span>₹<%= subtotal.toFixed(2) %></span>
                    </div>
                    <div class="total-row discount-row" id="discountRow" style="display: none;">
                        <span>Discount:</span>
                        <span>-₹<span id="discountAmount">0.00</span></span>
                    </div>
                    <div class="total-row grand-total">
                        <span>Total:</span>
                        <span>₹<span id="totalAmount"><%= subtotal.toFixed(2) %></span></span>
                    </div>
                </div>

                <!-- Coupon Section -->
                <div class="coupon-section">
                    <h3>Have a coupon?</h3>
                    <div class="coupon-input-group">
                        <input type="text" id="couponCode" placeholder="Enter coupon code">
                        <button onclick="applyCoupon()" class="btn-apply">Apply</button>
                    </div>
                    <div id="couponMessage" class="coupon-message"></div>
                </div>
            </div>

            <!-- Payment Section -->
            <div class="payment-section">
                <h2>Payment</h2>
                <div class="qr-container" id="qrContainer">
                    <div class="qr-loading">Loading QR code...</div>
                </div>
                
                <div class="upi-details">
                    <p><strong>UPI ID:</strong> <span id="upiId"><%= upiId %></span></p>
                    <p><strong>Amount:</strong> ₹<span id="paymentAmount"><%= total.toFixed(2) %></span></p>
                </div>

                <form action="/checkout/place-order" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="proof">Upload Payment Proof</label>
                        <input type="file" name="proof" id="proof" accept="image/*" required>
                        <small>Upload screenshot of payment</small>
                    </div>
                    <button type="submit" class="btn-submit">Complete Order</button>
                </form>
            </div>
        </div>
    </div>

    <style>
        .checkout-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        .order-summary, .payment-section {
            background: #111;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 2rem;
        }
        .order-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid #333;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
        }
        .grand-total {
            font-size: 1.2rem;
            font-weight: bold;
            color: #ff0000;
            border-top: 1px solid #333;
            margin-top: 0.5rem;
            padding-top: 0.5rem;
        }
        .coupon-section {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #333;
        }
        .coupon-input-group {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }
        .coupon-input-group input {
            flex: 1;
            padding: 0.5rem;
            background: #1a1a1a;
            border: 1px solid #333;
            color: white;
        }
        .btn-apply {
            padding: 0.5rem 1rem;
            background: #ff0000;
            color: white;
            border: none;
            cursor: pointer;
        }
        .qr-container {
            text-align: center;
            margin: 1rem 0;
            min-height: 200px;
        }
        .qr-code-img {
            max-width: 200px;
            border: 2px solid #ff0000;
        }
        .upi-details {
            background: #1a1a1a;
            padding: 1rem;
            margin: 1rem 0;
        }
        .form-group {
            margin-bottom: 1rem;
        }
        .form-group label {
            display: block;
            margin-bottom: 0.3rem;
        }
        .form-group input {
            width: 100%;
            padding: 0.5rem;
            background: #1a1a1a;
            border: 1px solid #333;
            color: white;
        }
        .btn-submit {
            width: 100%;
            padding: 1rem;
            background: #ff0000;
            color: white;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }
    </style>

    <script>
        let currentSubtotal = <%= subtotal %>;
        let currentTotal = <%= total %>;
        
        async function loadQRCode() {
            try {
                const res = await fetch(`/api/generate-upi-qr?amount=${currentTotal}`);
                const data = await res.json();
                if (data.success) {
                    document.getElementById('qrContainer').innerHTML = `<img src="${data.qrDataUrl}" class="qr-code-img">`;
                }
            } catch (e) {}
        }
        
        loadQRCode();
        
        async function applyCoupon() {
            const code = document.getElementById('couponCode').value;
            const res = await fetch('/checkout/apply-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code })
            });
            const data = await res.json();
            
            if (data.valid) {
                let discount = data.type === 'percentage' ? currentSubtotal * (data.discount / 100) : data.discount;
                currentTotal = Math.max(0, currentSubtotal - discount);
                
                document.getElementById('discountRow').style.display = 'flex';
                document.getElementById('discountAmount').textContent = discount.toFixed(2);
                document.getElementById('totalAmount').textContent = currentTotal.toFixed(2);
                document.getElementById('paymentAmount').textContent = currentTotal.toFixed(2);
                
                loadQRCode();
                document.getElementById('couponMessage').innerHTML = '✅ Coupon applied!';
            } else {
                document.getElementById('couponMessage').innerHTML = '❌ Invalid coupon';
            }
        }
    </script>

    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <span class="logo-imposter">IMPOSTER</span>
                <span class="logo-network">NETWORK</span>
                <p>Premium digital marketplace</p>
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <a href="/terms">Terms</a>
                <a href="/history">History</a>
            </div>
            <div class="footer-copyright">
                <p>IMPOSTER Network © 2026-2027</p>
            </div>
        </div>
    </footer>
</body>
</html>

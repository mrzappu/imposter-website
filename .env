# Discord OAuth
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=https://your-app.onrender.com/auth/discord/callback

# Discord Bot
DISCORD_BOT_TOKEN=your_bot_token

# Channel IDs
LOGIN_LOG_CHANNEL=123456789012345678
PAYMENT_LOG_CHANNEL=123456789012345678
APPROVED_LOG_CHANNEL=123456789012345678

# Role ID
AUTO_ROLE_ID=123456789012345678

# Session Secret
SESSION_SECRET=your_super_secret_key_change_this

# Server URL
BASE_URL=https://your-app.onrender.com

# Admin Discord ID
ADMIN_DISCORD_ID=your_discord_id
